# .env — copy to this exact filename at the project root; docker-compose reads it automatically.
# Never commit the real .env file.

# Your Supabase (or any Postgres+PostGIS) connection string.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db.yourproject.supabase.co:5432/postgres

# Directory on the host containing your model NetCDF file(s).
# The file actually served is backend/app/model_source.py's MODEL_NC_PATH,
# which docker-compose.yml points at /data/model.nc inside the container —
# so name/symlink your file to model.nc in this directory, or edit
# MODEL_NC_PATH in docker-compose.yml to match your real filename.
MODEL_DATA_DIR=./data

# Port to expose the frontend on (80 = default http)
HTTP_PORT=80
